# Service account mode: set both fields. Leave both empty for OAuth setup.
GOOGLE_CLIENT_EMAIL=

#secret
# Service account private key on one line, with literal \n for newlines.
GOOGLE_PRIVATE_KEY=

# Optional custom OAuth desktop client. Leave empty for upstream defaults.
GOOGLE_CLIENT_ID=
#secret
GOOGLE_CLIENT_SECRET=

# Optional PageSpeed Insights API key; not Search Console authentication.
#secret
PAGESPEED_API_KEY=
