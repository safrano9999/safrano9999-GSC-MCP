# syntax=docker/dockerfile:1.7
# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
# Existing third-party Supergateway pin from the Smart1 inventory.
FROM docker.io/supercorp/supergateway:4.1.0@sha256:1938c43538a5308bce07d58028e9de00b7acfecb40b39b059b2f3931800ad910

ARG SEARCH_CONSOLE_MCP_VERSION=2.1.3
LABEL org.opencontainers.image.title="safrano9999-GSC-MCP" \
      org.opencontainers.image.source="https://github.com/safrano9999/safrano9999-GSC-MCP" \
      io.safrano9999.upstream.source="https://github.com/saurabhsharma2u/search-console-mcp" \
      io.safrano9999.upstream.version="${SEARCH_CONSOLE_MCP_VERSION}"

USER root
RUN npm install --global --omit=dev "search-console-mcp@${SEARCH_CONSOLE_MCP_VERSION}" \
    && npm cache clean --force \
    && mkdir -p /data /opt/gsc-mcp /var/lib/dbus \
    && chown node:node /data \
    && chmod 0700 /data \
    && ln -sf /data/machine-id /etc/machine-id \
    && ln -sf /data/machine-id /var/lib/dbus/machine-id

COPY --chmod=0755 runtime/entrypoint.sh /usr/local/bin/gsc-mcp-entrypoint
COPY runtime/init-state.mjs /opt/gsc-mcp/init-state.mjs

ENV NODE_ENV=production HOME=/data USER=node
WORKDIR /data
USER node
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD node -e 'fetch("http://127.0.0.1:8000/healthz").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))'
ENTRYPOINT ["/usr/local/bin/gsc-mcp-entrypoint"]
CMD []
